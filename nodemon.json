{
  "watch": ["src"],
  "ext": "ts,js,json,prisma",
  "ignore": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts", 
    "node_modules",
    "dist",
    "logs",
    "uploads",
    "src/generated"
  ],
  "exec": "ts-node --transpile-only src/index.ts",
  "env": {
    "NODE_ENV": "development",
    "TS_NODE_PROJECT": "./tsconfig.json"
  },
  "delay": 1500,
  "verbose": true,
  "colours": true,
  "legacyWatch": false,
  "restartable": "rs"
}
