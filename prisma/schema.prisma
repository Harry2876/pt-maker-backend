generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                   @id @default(cuid())
  username              String                   @unique
  subscriptionId        String?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  phoneNumber           String                   @unique
  credits               Int                      @default(0)
  otp                   String?
  otpExpiresAt          DateTime?
  passwordHash          String?
  subscriptionEndDate   DateTime?
  subscriptionStatus    SubscriptionStatus       @default(INACTIVE)
  fullName              String
  organization          String?
  registeredAppVersion  String?
  lastAppVersion        String?
  lastVersionUpdate     DateTime?
  accounts              Account[]
  activityLogs          ActivityLog[]
  discordUser           DiscordUser?             @relation("UserDiscordLink")
  verifiedResults       MatchResult[]
  payments              Payment[]
  sessions              Session[]
  slotAssignments       SlotAssignment[]
  teams                 Team[]
  templates             Template[]
  invitedCollaborators  TournamentCollaborator[] @relation("InvitedCollaborators")
  collaborations        TournamentCollaborator[]
  tournaments           Tournament[]
  quickMatches          QuickMatch[]
  subscription          Subscription?            @relation(fields: [subscriptionId], references: [id])
  quickTournamentSeries QuickTournamentSeries[]
  tieBreakingConfigs    TieBreakingConfig[]
  resolvedConflicts     ConflictGroup[]

  @@map("users")
}

model TournamentCollaborator {
  id           String             @id @default(cuid())
  tournamentId String
  userId       String
  role         UserRole           @default(VIEWER)
  status       CollaboratorStatus @default(PENDING)
  invitedBy    String
  invitedAt    DateTime           @default(now())
  acceptedAt   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  inviter      User               @relation("InvitedCollaborators", fields: [invitedBy], references: [id])
  tournament   Tournament         @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, userId])
  @@map("tournament_collaborators")
}

model TournamentStage {
  id                 String      @id @default(cuid())
  name               String
  stageNumber        Int
  totalGroups        Int         @default(1)
  qualificationSpots Int         @default(8)
  stageFormat        StageFormat @default(ELIMINATION)
  isActive           Boolean     @default(false)
  isCompleted        Boolean     @default(false)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  tournamentId       String
  groups             Group[]
  tournament         Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@map("tournament_stages")
}

model Player {
  id           String       @id @default(cuid())
  name         String
  gameUuid     String?
  email        String?
  phoneNumber  String?
  totalMatches Int          @default(0)
  totalKills   Int          @default(0)
  totalPoints  Int          @default(0)
  averageKills Float        @default(0)
  bestPosition Int?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  playerStats  PlayerStat[]

  @@map("players")
}

model PlayerStat {
  id           String     @id @default(cuid())
  playerId     String
  tournamentId String
  teamName     String
  matches      Int        @default(0)
  totalKills   Int        @default(0)
  totalPoints  Int        @default(0)
  averageKills Float      @default(0)
  bestPosition Int?
  player       Player     @relation(fields: [playerId], references: [id], onDelete: Cascade)
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([playerId, tournamentId])
  @@map("player_stats")
}

model SlotAssignment {
  id                 String            @id @default(cuid())
  slotNumber         Int
  groupId            String
  teamRegistrationId String?
  isActive           Boolean           @default(true)
  assignedAt         DateTime          @default(now())
  assignedBy         String
  slotType           String            @default("TEAM_SLOT")
  assignedByUser     User              @relation(fields: [assignedBy], references: [id])
  group              Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  teamRegistration   TeamRegistration? @relation(fields: [teamRegistrationId], references: [id])

  @@unique([groupId, slotNumber])
  @@index([groupId, isActive])
  @@index([teamRegistrationId])
  @@index([groupId, slotNumber])
  @@map("slot_assignments")
}

model ScoringRule {
  id                 String     @id @default(cuid())
  tournamentId       String
  killPoints         Int        @default(1)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  createdBy          String
  customFormula      String?
  description        String?
  isActive           Boolean    @default(true)
  positionMultiplier Float      @default(1.0)
  priority           Int        @default(1)
  ruleName           String
  ruleType           String
  tournament         Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, priority])
  @@map("scoring_rules")
}

model MatchResult {
  id                 String           @id @default(cuid())
  matchId            String
  teamRegistrationId String
  slotNumber         Int
  position           Int
  totalKills         Int
  killPoints         Int
  positionPoints     Int
  totalMatchPoints   Int
  playerResults      Json
  verifiedBy         String?
  verifiedAt         DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  match              Match            @relation(fields: [matchId], references: [id], onDelete: Cascade)
  teamRegistration   TeamRegistration @relation(fields: [teamRegistrationId], references: [id], onDelete: Cascade)
  verifier           User?            @relation(fields: [verifiedBy], references: [id])

  @@unique([matchId, teamRegistrationId])
  @@index([teamRegistrationId, createdAt])
  @@index([matchId, position])
  @@index([teamRegistrationId, totalMatchPoints(sort: Desc)])
  @@index([matchId, totalKills(sort: Desc)])
  @@index([createdAt])
  @@map("match_results")
}

model Subscription {
  id            String       @id @default(cuid())
  price         Float
  features      Json
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  billingCycle  BillingCycle
  planName      String
  stripePriceId String?      @unique
  users         User[]

  @@map("subscriptions")
}

model Tournament {
  id                 String                   @id @default(cuid())
  name               String
  game               String
  status             TournamentStatus         @default(UPCOMING)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  userId             String
  entryFee           Float?
  maxTeams           Int?
  prizePool          Float?
  tournamentType     TournamentType           @default(TOURNAMENT)
  allowCollaborators Boolean                  @default(false)
  currentStage       Int                      @default(1)
  maxTeamsPerGroup   Int                      @default(25)
  registrationFields Json?
  totalStages        Int                      @default(1)
  tournamentFormat   TournamentFormat         @default(ELIMINATION)
  groups             Group[]
  matches            Match[]
  playerStats        PlayerStat[]
  scoringRule        ScoringRule[]
  teamRegistrations  TeamRegistration[]
  collaborators      TournamentCollaborator[]
  stages             TournamentStage[]
  user               User                     @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@index([game, status])
  @@index([name])
  @@map("tournaments")
}

model Team {
  id        String   @id @default(cuid())
  name      String
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  @@map("teams")
}

model Match {
  id            String        @id @default(cuid())
  matchNumber   Int
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  matchDate     DateTime      @default(now())
  processedData Json?
  status        MatchStatus   @default(PENDING_PROCESSING)
  tournamentId  String
  groupId       String?
  resultStatus  ResultStatus  @default(PENDING)
  stageNumber   Int?
  matchResults  MatchResult[]
  group         Group?        @relation(fields: [groupId], references: [id])
  tournament    Tournament    @relation(fields: [tournamentId], references: [id])
  screenshots   Screenshot[]

  @@index([tournamentId, matchNumber])
  @@index([groupId, matchNumber])
  @@index([status, createdAt])
  @@index([tournamentId, status])
  @@index([resultStatus])
  @@map("matches")
}

model Screenshot {
  id           String         @id @default(cuid())
  originalName String
  fileName     String
  fileSize     Int
  mimeType     String
  type         ScreenshotType
  storageUrl   String
  isProcessed  Boolean        @default(false)
  uploadedAt   DateTime       @default(now())
  matchId      String
  match        Match          @relation(fields: [matchId], references: [id])

  @@map("screenshots")
}

model Template {
  id               String              @id @default(cuid())
  templateName     String
  imageUrl         String
  configJson       Json
  isPublic         Boolean             @default(false)
  templateType     TemplateType        @default(PREDEFINED)
  originalImageUrl String?
  isActive         Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  userId           String
  dataFields       TemplateDataField[]
  user             User                @relation(fields: [userId], references: [id])

  @@map("templates")
}

model TemplateDataField {
  id         String        @id @default(cuid())
  fieldType  DataFieldType
  x          Int
  y          Int
  width      Int
  height     Int
  fontSize   Int?
  fontColor  String?
  alignment  TextAlignment @default(LEFT)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  templateId String
  template   Template      @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@map("template_data_fields")
}

model Group {
  id                 String             @id @default(cuid())
  name               String
  maxTeams           Int                @default(24)
  qualificationSpots Int                @default(8)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  tournamentId       String
  matchCount         Int                @default(1)
  maxSlots           Int                @default(25)
  stageId            String?
  stage              TournamentStage?   @relation(fields: [stageId], references: [id])
  tournament         Tournament         @relation(fields: [tournamentId], references: [id])
  matches            Match[]
  slotAssignments    SlotAssignment[]
  teamRegistrations  TeamRegistration[]

  @@index([tournamentId])
  @@index([stageId])
  @@index([tournamentId, createdAt])
  @@map("groups")
}

model TeamRegistration {
  id                 String           @id @default(cuid())
  teamName           String
  contactInfo        String
  registrationStatus String           @default("PENDING")
  finalPosition      Int?
  totalPoints        Int              @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  tournamentId       String
  groupId            String?
  currentStage       Int              @default(1)
  playerDetails      Json?
  slotNumber         Int?
  matchResults       MatchResult[]
  slotAssignments    SlotAssignment[]
  group              Group?           @relation(fields: [groupId], references: [id])
  tournament         Tournament       @relation(fields: [tournamentId], references: [id])

  @@index([tournamentId, totalPoints(sort: Desc)])
  @@index([groupId, totalPoints(sort: Desc)])
  @@index([tournamentId, createdAt])
  @@index([tournamentId, registrationStatus])
  @@index([teamName])
  @@index([totalPoints(sort: Desc), createdAt])
  @@index([currentStage, totalPoints(sort: Desc)])
  @@map("team_registrations")
}

model Payment {
  id            String        @id @default(cuid())
  amount        Float
  currency      String        @default("INR")
  status        PaymentStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  userId        String
  creditsAdded  Int?
  purchaseType  PurchaseType
  transactionId String        @unique
  user          User          @relation(fields: [userId], references: [id])

  @@map("payments")
}

model ActivityLog {
  id        String   @id @default(cuid())
  action    String
  details   Json?
  timestamp DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  @@map("activity_logs")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id                    String   @id @default(cuid())
  userId                String
  createdAt             DateTime @default(now())
  deviceInfo            String?
  ipAddress             String?
  isActive              Boolean  @default(true)
  lastUsedAt            DateTime @default(now())
  refreshTokenExpiresAt DateTime
  refreshTokenHash      String   @unique
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model DiscordUser {
  id               String               @id
  username         String
  discriminator    String?
  email            String?
  avatar           String?
  verified         Boolean              @default(false)
  locale           String?
  mfaEnabled       Boolean              @default(false)
  linkedUserId     String?              @unique
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  guildMemberships DiscordGuildMember[]
  ownedGuilds      DiscordGuild[]       @relation("GuildOwner")
  linkedUser       User?                @relation("UserDiscordLink", fields: [linkedUserId], references: [id])

  @@map("discord_users")
}

model DiscordGuild {
  id                   String                       @id
  name                 String
  icon                 String?
  description          String?
  memberCount          Int                          @default(0)
  ownerId              String
  botEnabled           Boolean                      @default(true)
  commandPrefix        String                       @default("sz")
  isPremium            Boolean                      @default(false)
  premiumUntil         DateTime?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  botStates            BotState[]                   @relation("BotStateGuild")
  members              DiscordGuildMember[]
  owner                DiscordUser                  @relation("GuildOwner", fields: [ownerId], references: [id])
  scrims               DiscordScrim[]
  teamEnrollments      TeamEnrollment[]
  registrationSessions DiscordRegistrationSession[]
  teamMerits           DiscordTeamMerit[]
  registrationDelays   DiscordRegistrationDelay[]
  registrationToggle   DiscordRegistrationToggle?
  teamBans             DiscordTeamBan[]

  @@map("discord_guilds")
}

model DiscordGuildMember {
  id                   String       @id @default(cuid())
  userId               String
  guildId              String
  nickname             String?
  roles                String[]
  joinedAt             DateTime
  isAdmin              Boolean      @default(false)
  canManageTournaments Boolean      @default(false)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  guild                DiscordGuild @relation(fields: [guildId], references: [id])
  user                 DiscordUser  @relation(fields: [userId], references: [id])

  @@unique([userId, guildId])
  @@map("discord_guild_members")
}

model DiscordScrim {
  id          String       @id @default(cuid())
  guildId     String
  name        String
  description String?
  game        String
  maxTeams    Int
  status      String       @default("open")
  scheduledAt DateTime?
  duration    Int?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  guild       DiscordGuild @relation(fields: [guildId], references: [id])

  @@map("discord_scrims")
}

model BotState {
  id            String       @id @default(cuid())
  guildId       String
  state         String
  previousState String?
  reason        String
  changedAt     DateTime     @default(now())
  changedBy     String?
  metadata      Json?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  guild         DiscordGuild @relation("BotStateGuild", fields: [guildId], references: [id])

  @@index([guildId])
  @@index([state])
  @@map("bot_states")
}

model TeamEnrollment {
  id       String @id @default(cuid())
  guildId  String
  teamName String

  // Leader info
  leaderId      String
  leaderIgn     String
  leaderDiscord String

  players Json

  // Status and validation
  isVerified     Boolean @default(false)
  isComplete     Boolean @default(false)
  enrollmentStep Int     @default(1)

  // Metadata
  threadId   String?
  enrolledBy String
  enrolledAt DateTime  @default(now())
  verifiedAt DateTime?

  // Relations
  guild        DiscordGuild      @relation(fields: [guildId], references: [id])
  activityLogs TeamActivityLog[]
  nameChanges  TeamNameChange[]

  @@unique([guildId, teamName])
  @@map("team_enrollments")
}

model TeamActivityLog {
  id           String   @id @default(cuid())
  teamId       String
  guildId      String
  action       String
  performedBy  String
  previousData Json?
  newData      Json?
  timestamp    DateTime @default(now())

  team TeamEnrollment @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@map("team_activity_logs")
}

// User Rate Limiting (for enrollment threads)
model UserRateLimit {
  id            String   @id @default(cuid())
  userId        String
  guildId       String
  action        String
  lastAttempt   DateTime @default(now())
  attemptCount  Int      @default(1)
  cooldownUntil DateTime
  isAdmin       Boolean  @default(false)

  @@unique([userId, guildId, action])
  @@map("user_rate_limits")
}

model TeamNameChange {
  id        String   @id @default(cuid())
  teamId    String
  guildId   String
  oldName   String
  newName   String
  changedBy String
  changedAt DateTime @default(now())

  team TeamEnrollment @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@map("team_name_changes")
}

model DiscordRegistrationSession {
  id           String             @id @default(cuid())
  guildId      String
  channelId    String
  name         String
  groupId      Int
  isActive     Boolean            @default(false)
  maxSlots     Int                @default(21)
  currentSlots Int                @default(0)
  startedAt    DateTime?
  endedAt      DateTime?
  duration     Int                @default(30) // minutes
  status       RegistrationStatus @default(PENDING)
  createdBy    String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  // Relations
  guild        DiscordGuild               @relation(fields: [guildId], references: [id], onDelete: Cascade)
  queueEntries DiscordRegistrationQueue[]

  @@unique([guildId, channelId]) // One session per channel
  // Indexes for performance (following your patterns)
  @@index([guildId])
  @@index([channelId])
  @@index([status])
  @@map("discord_registration_sessions")
}

model DiscordRegistrationQueue {
  id           String      @id @default(cuid())
  sessionId    String
  guildId      String
  teamName     String
  userId       String
  userDiscord  String
  merit        Int         @default(100)
  position     Int
  status       QueueStatus @default(QUEUED)
  joinedAt     DateTime    @default(now())
  assignedSlot Int?
  assignedAt   DateTime?
  processedAt  DateTime?

  // Relations
  session DiscordRegistrationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, teamName]) // One queue entry per team per session
  // Indexes for performance
  @@index([sessionId])
  @@index([guildId])
  @@index([merit]) // For merit-based sorting
  @@index([status])
  @@map("discord_registration_queue")
}

model DiscordTeamMerit {
  id           String       @id @default(cuid())
  guildId      String
  teamName     String
  currentMerit Int          @default(100)
  totalEarned  Int          @default(0)
  totalLost    Int          @default(0)
  lastAction   MeritAction?
  lastUpdated  DateTime     @updatedAt
  updatedBy    String?
  notes        String?

  // Relations
  guild DiscordGuild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, teamName]) // One merit record per team per guild
  // Indexes for performance
  @@index([guildId])
  @@index([currentMerit]) // For merit rankings
  @@map("discord_team_merit")
}

model DiscordRegistrationDelay {
  id           String    @id @default(cuid())
  guildId      String
  teamName     String? // null means server-wide delay
  delayType    DelayType @default(REGISTRATION_COOLDOWN)
  delayMinutes Int
  reason       String
  expiresAt    DateTime
  setBy        String
  setByName    String
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())

  // Relations
  guild DiscordGuild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  // Indexes for performance
  @@index([guildId])
  @@index([expiresAt])
  @@index([isActive])
  @@map("discord_registration_delays")
}

model DiscordRegistrationToggle {
  id            String   @id @default(cuid())
  guildId       String   @unique
  enabled       Boolean  @default(true)
  toggledBy     String
  toggledByName String
  toggledAt     DateTime @default(now())
  toggleCount   Int      @default(0)
  reason        String?

  // Relations
  guild DiscordGuild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  // Indexes for performance
  @@index([enabled])
  @@map("discord_registration_toggles")
}

model DiscordTeamBan {
  id             String         @id @default(cuid())
  guildId        String
  teamName       String
  punishmentType PunishmentType
  reason         String
  bannedBy       String
  bannedByName   String
  bannedAt       DateTime       @default(now())
  endTime        DateTime?
  isActive       Boolean        @default(true)
  appealNotes    String?

  // Relations
  guild DiscordGuild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, teamName]) // One active ban per team per guild
  // Indexes for performance
  @@index([guildId])
  @@index([isActive])
  @@index([endTime])
  @@map("discord_team_bans")
}

model QuickTournamentSeries {
  id               String            @id @default(cuid())
  seriesName       String
  game             String            @default("BGMI")
  totalMatches     Int               @default(3)
  matchesCompleted Int               @default(0)
  status           QuickSeriesStatus @default(CREATED)

  // Aggregated scoring config (inherited by matches)
  positionPointsConfig Json?
  killPointsValue      Int     @default(1)
  scoringDescription   String?

  // Series progression
  currentMatchNumber Int     @default(1)
  isFinished         Boolean @default(false)
  winnerTeamName     String?
  finalStandings     Json? // Array of team standings

  // Metadata
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  seriesMatches QuickSeriesMatch[]
  leaderboard   QuickSeriesLeaderboard?

  // Indexes
  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@index([userId, status])
  @@map("quick_tournament_series")
}

model QuickSeriesMatch {
  id           String    @id @default(cuid())
  seriesId     String
  quickMatchId String    @unique
  matchOrder   Int // 1st match, 2nd match, etc.
  isCompleted  Boolean   @default(false)
  completedAt  DateTime?

  // Match-specific overrides (optional)
  matchWeight Float @default(1.0) // For weighted scoring
  bonusPoints Int   @default(0) // Bonus points for this match

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  series     QuickTournamentSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  quickMatch QuickMatch            @relation(fields: [quickMatchId], references: [id], onDelete: Cascade)

  // Indexes
  @@unique([seriesId, matchOrder])
  @@index([seriesId, matchOrder])
  @@index([quickMatchId])
  @@map("quick_series_matches")
}

model QuickSeriesLeaderboard {
  id               String   @id @default(cuid())
  seriesId         String   @unique
  leaderboardData  Json // Array of team standings with aggregated scores
  lastUpdatedMatch Int      @default(0)
  generatedAt      DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  series QuickTournamentSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  // Indexes
  @@index([seriesId])
  @@map("quick_series_leaderboards")
}

model QuickMatch {
  id             String           @id @default(cuid())
  matchName      String
  game           String           @default("BGMI")
  map            String?
  status         QuickMatchStatus
  processingStep String?
  aiProcessingId String?
  teamsDetected  Int              @default(0)
  warningsCount  Int              @default(0)

  positionPointsConfig Json?
  killPointsValue      Int     @default(1) // Points per kill
  scoringDescription   String?

  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations (rest stays same)
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  slotAssignments QuickSlotAssignment[]
  screenshots     QuickScreenshot[]
  results         QuickMatchResult[]
  pointsTable     QuickPointsTable?
  seriesMatch     QuickSeriesMatch?
  QuickMatchCrop  QuickMatchCrop[]

  // Indexes (rest stays same)
  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@index([userId, status])
  @@map("quick_matches")
}

model QuickSlotAssignment {
  id                   String     @id @default(cuid())
  quickMatchId         String
  slotNumber           Int
  teamName             String
  playerNames          Json? // Array of player names
  status               SlotStatus @default(PENDING)
  detectedInAttendance Boolean    @default(false)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  // Relations
  quickMatch QuickMatch @relation(fields: [quickMatchId], references: [id], onDelete: Cascade)

  // Indexes
  @@unique([quickMatchId, slotNumber])
  @@index([quickMatchId, status])
  @@index([quickMatchId, teamName])
  @@map("quick_slot_assignments")
}

model QuickScreenshot {
  id           String              @id @default(cuid())
  quickMatchId String
  originalName String
  fileName     String
  storageUrl   String
  type         QuickScreenshotType
  pageNumber   Int?
  isProcessed  Boolean             @default(false)
  uploadedAt   DateTime            @default(now())

  // Relations
  quickMatch QuickMatch @relation(fields: [quickMatchId], references: [id], onDelete: Cascade)

  // Indexes
  @@index([quickMatchId, type])
  @@index([quickMatchId, isProcessed])
  @@map("quick_screenshots")
}

model QuickMatchResult {
  id               String       @id @default(cuid())
  quickMatchId     String
  slotNumber       Int
  teamName         String
  detectedTeamName String?
  position         Int
  rank             Int
  totalKills       Int
  positionPoints   Int
  killPoints       Int
  totalPoints      Int
  playerResults    Json? // Individual player stats
  status           ResultStatus @default(PENDING)
  warningType      String?
  needsReview      Boolean      @default(false)
  aiConfidence     Float?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  // Relations
  quickMatch QuickMatch @relation(fields: [quickMatchId], references: [id], onDelete: Cascade)

  // Indexes
  @@unique([quickMatchId, slotNumber])
  @@index([quickMatchId, totalPoints(sort: Desc)])
  @@index([quickMatchId, needsReview])
  @@index([quickMatchId, position])
  @@map("quick_match_results")
}

model QuickMatchCrop {
  id           String    @id @default(cuid())
  quickMatchId String
  originalUrl  String // Original screenshot URL
  cropUrl      String // Crop image R2 URL  
  r2Key        String // R2 storage key
  cropData     Json // Crop coordinates/metadata from Python API
  cropType     String // Type of crop (e.g., "kill_feed", "leaderboard")
  isActive     Boolean   @default(true)
  expiresAt    DateTime? // For cleanup
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  quickMatch QuickMatch @relation(fields: [quickMatchId], references: [id], onDelete: Cascade)

  // Indexes
  @@index([quickMatchId, cropType])
  @@index([quickMatchId, isActive])
  @@index([expiresAt])
  @@map("quick_match_crops")
}

model QuickPointsTable {
  id               String    @id @default(cuid())
  quickMatchId     String    @unique
  tableImageUrl    String?
  csvData          Json?
  pngGeneratedAt   DateTime?
  generationTimeMs Int?
  template         String    @default("default")
  expiresAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relations
  quickMatch QuickMatch @relation(fields: [quickMatchId], references: [id], onDelete: Cascade)

  // Indexes
  @@index([quickMatchId])
  @@index([expiresAt])
  @@map("quick_points_tables")
}

