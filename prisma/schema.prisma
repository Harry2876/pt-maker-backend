// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  PAST_DUE
  CANCELED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum TournamentStatus {
  UPCOMING
  ONGOING
  COMPLETED
}

enum MatchStatus {
  PENDING_PROCESSING
  PROCESSED
  ERROR
}

enum PaymentStatus {
  SUCCEEDED
  PENDING
  FAILED
}

enum PurchaseType {
  SUBSCRIPTION
  CREDIT_PACK
}

enum ScreenshotType {
  SLOT_LIST // Team slot assignments
  RESULT_SCREEN // Match results
}

enum TemplateType {
  PREDEFINED // Pre-designed templates provided by platform
  CUSTOM // User-uploaded custom designs
}

enum DataFieldType {
  TEAM_NAME // Team name field
  PLAYER_NAME // Player name field
  KILLS // Kill count field
  POSITION // Position/rank field
  POINTS // Points field
  MATCH_TITLE // Match title field
  DATE // Date field
  TOURNAMENT_NAME // Tournament name field
}

enum TournamentFormat {
  ELIMINATION
  ROUND_ROBIN
  MIXED
}

enum StageFormat {
  ELIMINATION
  ROUND_ROBIN
}

enum ResultStatus {
  PENDING
  PROCESSED
  VERIFIED
  MANUAL_ENTRY
}

enum UserRole {
  OWNER
  ADMIN
  MODERATOR
  RESULT_VERIFIER
  VIEWER
}

enum CollaboratorStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum TextAlignment {
  LEFT
  CENTER
  RIGHT
}

// ============================================================================
// CORE MODELS
// ============================================================================

// Users (Tournament Organizers)
model User {
  id                  String             @id @default(cuid())
  username            String             @unique
  phoneNumber         String             @unique // Primary authentication field
  fullName            String
  organization        String?
  passwordHash        String? // Optional for future email auth
  otp                 String? // Current OTP for phone verification
  otpExpiresAt        DateTime? // OTP expiration time
  credits             Int                @default(0) // Credits for generating graphics
  subscriptionStatus  SubscriptionStatus @default(INACTIVE)
  subscriptionEndDate DateTime? // When subscription expires
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  // Relations
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])

  // User-owned entities
  tournaments  Tournament[]
  teams        Team[]
  templates    Template[]
  payments     Payment[]
  activityLogs ActivityLog[]

  // Better Auth relations (keeping for compatibility)
  accounts             Account[]
  sessions             Session[]
  collaborations       TournamentCollaborator[]
  invitedCollaborators TournamentCollaborator[] @relation("InvitedCollaborators")
  slotAssignments      SlotAssignment[]
  verifiedResults      MatchResult[]

  @@map("users")
}

// Multi-user collaboration for tournaments
model TournamentCollaborator {
  id           String             @id @default(cuid())
  tournamentId String
  userId       String
  role         UserRole           @default(VIEWER)
  status       CollaboratorStatus @default(PENDING)
  invitedBy    String // User ID who sent invitation
  invitedAt    DateTime           @default(now())
  acceptedAt   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  inviter    User       @relation("InvitedCollaborators", fields: [invitedBy], references: [id])

  @@unique([tournamentId, userId])
  @@map("tournament_collaborators")
}

// Tournament stages for multi-round tournaments
model TournamentStage {
  id                 String      @id @default(cuid())
  name               String // "Round 1", "Quarter Finals", etc.
  stageNumber        Int
  totalGroups        Int         @default(1)
  qualificationSpots Int         @default(8) // Teams qualifying to next stage
  stageFormat        StageFormat @default(ELIMINATION)
  isActive           Boolean     @default(false)
  isCompleted        Boolean     @default(false)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  groups       Group[]

  @@map("tournament_stages")
}

// Global player database for analytics
model Player {
  id           String   @id @default(cuid())
  name         String
  gameUuid     String? // BGMI character UUID
  email        String?
  phoneNumber  String?
  totalMatches Int      @default(0)
  totalKills   Int      @default(0)
  totalPoints  Int      @default(0)
  averageKills Float    @default(0)
  bestPosition Int? // Best finishing position
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  playerStats PlayerStat[]

  @@map("players")
}

// Player statistics per tournament
model PlayerStat {
  id           String @id @default(cuid())
  playerId     String
  tournamentId String
  teamName     String
  matches      Int    @default(0)
  totalKills   Int    @default(0)
  totalPoints  Int    @default(0)
  averageKills Float  @default(0)
  bestPosition Int?

  player     Player     @relation(fields: [playerId], references: [id], onDelete: Cascade)
  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([playerId, tournamentId])
  @@map("player_stats")
}

// Slot assignments for each group
model SlotAssignment {
  id                 String   @id @default(cuid())
  slotNumber         Int // 1-25
  groupId            String
  teamRegistrationId String? // null for empty slots
  isActive           Boolean  @default(true)
  assignedAt         DateTime @default(now())
  assignedBy         String // User who assigned the slot

  group            Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  teamRegistration TeamRegistration? @relation(fields: [teamRegistrationId], references: [id], onDelete: SetNull)
  assignedByUser   User              @relation(fields: [assignedBy], references: [id])

  @@unique([groupId, slotNumber])
  @@map("slot_assignments")
}

// Custom scoring rules per tournament
model ScoringRule {
  id                 String   @id @default(cuid())
  tournamentId       String
  ruleName           String
  ruleType           String // 'KILL_POINTS' | 'POSITION_POINTS' | 'SURVIVAL_TIME' | 'CUSTOM_FORMULA'
  isActive           Boolean  @default(true)
  priority           Int      @default(1)
  killPoints         Int      @default(1)
  positionMultiplier Float    @default(1.0)
  customFormula      String?
  description        String?
  createdBy          String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, priority]) // Prevent duplicate priorities
  @@map("scoring_rules")
}

// Match results for each team per match
model MatchResult {
  id                 String    @id @default(cuid())
  matchId            String
  teamRegistrationId String
  slotNumber         Int
  position           Int // Final position (1-25)
  totalKills         Int // Sum of all player kills
  killPoints         Int // Calculated kill points
  positionPoints     Int // Calculated position points
  totalMatchPoints   Int // killPoints + positionPoints
  playerResults      Json // [{playerName, kills}, ...] 
  verifiedBy         String? // User who verified the results
  verifiedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  match            Match            @relation(fields: [matchId], references: [id], onDelete: Cascade)
  teamRegistration TeamRegistration @relation(fields: [teamRegistrationId], references: [id], onDelete: Cascade)
  verifier         User?            @relation(fields: [verifiedBy], references: [id])

  @@unique([matchId, teamRegistrationId])
  @@map("match_results")
}

// Subscription Plans (Free, Pro, Enterprise)
model Subscription {
  id            String       @id @default(cuid())
  planName      String // "Free", "Pro", "Enterprise"
  price         Float // Monthly/Yearly price
  stripePriceId String?      @unique // Stripe price ID for billing
  billingCycle  BillingCycle // MONTHLY or YEARLY
  features      Json // {"maxTournaments": 10, "maxCreditsPerMonth": 100}
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Relations
  users User[]

  @@map("subscriptions")
}

// Tournament Events (e.g., "BGMI Championship 2024")
model Tournament {
  id                 String           @id @default(cuid())
  name               String
  game               String
  tournamentType     TournamentType   @default(TOURNAMENT) // Add this
  maxTeams           Int? // Total teams for tournament
  entryFee           Float? // Entry fee per team
  prizePool          Float? // Total prize pool
  status             TournamentStatus @default(UPCOMING)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  totalStages        Int              @default(1)
  currentStage       Int              @default(1)
  tournamentFormat   TournamentFormat @default(ELIMINATION)
  maxTeamsPerGroup   Int              @default(25)
  registrationFields Json? // Custom fields like player names, UUIDs
  allowCollaborators Boolean          @default(false)

  // Relations
  userId            String
  user              User                     @relation(fields: [userId], references: [id])
  matches           Match[]
  groups            Group[]
  teamRegistrations TeamRegistration[]
  collaborators     TournamentCollaborator[]
  stages            TournamentStage[]
  scoringRule       ScoringRule[]
  playerStats       PlayerStat[]

  @@map("tournaments")
}

// Teams participating in tournaments
model Team {
  id        String   @id @default(cuid())
  name      String // "Team Alpha", "Mystic Warriors"
  logoUrl   String? // URL to team logo image
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@map("teams")
}

// Individual matches within tournaments
model Match {
  id            String       @id @default(cuid())
  matchDate     DateTime     @default(now())
  matchNumber   Int
  status        MatchStatus  @default(PENDING_PROCESSING)
  processedData Json?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  stageNumber   Int?
  resultStatus  ResultStatus @default(PENDING)

  // Relations
  tournamentId String
  tournament   Tournament    @relation(fields: [tournamentId], references: [id])
  groupId      String? // Add this for group-specific matches
  group        Group?        @relation(fields: [groupId], references: [id]) // Add this
  screenshots  Screenshot[]
  matchResults MatchResult[]

  @@map("matches")
}

// Screenshots uploaded for processing
model Screenshot {
  id           String         @id @default(cuid())
  originalName String // Original filename
  fileName     String // Stored filename
  fileSize     Int // File size in bytes
  mimeType     String // image/png, image/jpeg
  type         ScreenshotType // SLOT_LIST or RESULT_SCREEN
  storageUrl   String // URL where file is stored
  isProcessed  Boolean        @default(false)
  uploadedAt   DateTime       @default(now())

  // Relations
  matchId String
  match   Match  @relation(fields: [matchId], references: [id])

  @@map("screenshots")
}

// Custom graphic templates
model Template {
  id               String       @id @default(cuid())
  templateName     String // "Dark Theme", "Neon Style"
  imageUrl         String // URL to template preview image
  configJson       Json // Layout configuration for Python service
  isPublic         Boolean      @default(false) // Public templates available to all
  templateType     TemplateType @default(PREDEFINED) // PREDEFINED or CUSTOM
  originalImageUrl String? // Original uploaded image for custom templates
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  // Relations
  userId     String
  user       User                @relation(fields: [userId], references: [id])
  dataFields TemplateDataField[] // Marked data placement areas

  @@map("templates")
}

// Data field positioning for custom templates
model TemplateDataField {
  id        String        @id @default(cuid())
  fieldType DataFieldType // What type of data goes here
  x         Int // X coordinate on image
  y         Int // Y coordinate on image
  width     Int // Field width
  height    Int // Field height
  fontSize  Int? // Font size for text
  fontColor String? // Hex color code for text
  alignment TextAlignment @default(LEFT)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  // Relations
  templateId String
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@map("template_data_fields")
}

model Group {
  id                 String   @id @default(cuid())
  name               String // "Group A", "Group B", etc.
  maxTeams           Int      @default(24) // Max teams per group
  qualificationSpots Int      @default(8) // Top N teams qualify
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  stageId            String?
  matchCount         Int      @default(1)
  maxSlots           Int      @default(25)

  // Relations
  tournamentId      String
  tournament        Tournament         @relation(fields: [tournamentId], references: [id])
  teamRegistrations TeamRegistration[]
  matches           Match[]
  stage             TournamentStage?   @relation(fields: [stageId], references: [id])
  slotAssignments   SlotAssignment[]

  @@map("groups")
}

model TeamRegistration {
  id                 String   @id @default(cuid())
  teamName           String
  contactInfo        String // Phone/email
  registrationStatus String   @default("PENDING") // PENDING, CONFIRMED, QUALIFIED, ELIMINATED
  finalPosition      Int? // Final position in group
  totalPoints        Int      @default(0) // Cumulative points
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  playerDetails      Json? // [{name, uuid, email}, ...]
  currentStage       Int      @default(1)
  slotNumber         Int? // Current assigned slot

  // Relations
  tournamentId    String
  tournament      Tournament       @relation(fields: [tournamentId], references: [id])
  groupId         String?
  group           Group?           @relation(fields: [groupId], references: [id])
  slotAssignments SlotAssignment[]
  matchResults    MatchResult[]

  @@map("team_registrations")
}

// Payment transactions
model Payment {
  id            String        @id @default(cuid())
  amount        Float // Payment amount
  currency      String        @default("INR")
  transactionId String        @unique // Payment gateway transaction ID
  status        PaymentStatus @default(PENDING)
  purchaseType  PurchaseType // SUBSCRIPTION or CREDIT_PACK
  creditsAdded  Int? // Credits added if credit pack purchase
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@map("payments")
}

// Activity logging for auditing
model ActivityLog {
  id        String   @id @default(cuid())
  action    String // "TOURNAMENT_CREATED", "MATCH_PROCESSED", etc.
  details   Json? // Additional context data
  timestamp DateTime @default(now())

  // Relations
  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@map("activity_logs")
}

// ============================================================================
// BETTER AUTH REQUIRED MODELS
// ============================================================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id                    String   @id @default(cuid())
  userId                String
  refreshTokenHash      String   @unique
  refreshTokenExpiresAt DateTime
  isActive              Boolean  @default(true)
  deviceInfo            String? // Browser/Mobile app info
  ipAddress             String? // For suspicious login detection
  lastUsedAt            DateTime @default(now())
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// Add new enum
enum TournamentType {
  TOURNAMENT // Multiple groups, qualification system
}
