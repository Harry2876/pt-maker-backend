generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                   @id @default(cuid())
  username              String                   @unique
  subscriptionId        String?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  phoneNumber           String                   @unique
  credits               Int                      @default(0)
  otp                   String?
  otpExpiresAt          DateTime?
  passwordHash          String?
  subscriptionEndDate   DateTime?
  subscriptionStatus    SubscriptionStatus       @default(INACTIVE)
  fullName              String
  organization          String?
  accounts              Account[]
  activityLogs          ActivityLog[]
  verifiedResults       MatchResult[]
  payments              Payment[]
  sessions              Session[]
  slotAssignments       SlotAssignment[]
  teams                 Team[]
  templates             Template[]
  invitedCollaborators  TournamentCollaborator[] @relation("InvitedCollaborators")
  collaborations        TournamentCollaborator[]
  tournaments           Tournament[]
  quickMatches          QuickMatch[]
  subscription          Subscription?            @relation(fields: [subscriptionId], references: [id])
  quickTournamentSeries QuickTournamentSeries[]
  tieBreakingConfigs    TieBreakingConfig[]
  resolvedConflicts     ConflictGroup[]
  teamLogoPresets       TeamLogoPreset[]
  quickMediaAssets      QuickMediaAsset[]

  @@map("users")
}

model TournamentCollaborator {
  id           String             @id @default(cuid())
  tournamentId String
  userId       String
  role         UserRole           @default(VIEWER)
  status       CollaboratorStatus @default(PENDING)
  invitedBy    String
  invitedAt    DateTime           @default(now())
  acceptedAt   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  inviter      User               @relation("InvitedCollaborators", fields: [invitedBy], references: [id])
  tournament   Tournament         @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, userId])
  @@map("tournament_collaborators")
}

model TournamentStage {
  id                 String      @id @default(cuid())
  name               String
  stageNumber        Int
  totalGroups        Int         @default(1)
  qualificationSpots Int         @default(8)
  stageFormat        StageFormat @default(ELIMINATION)
  isActive           Boolean     @default(false)
  isCompleted        Boolean     @default(false)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  tournamentId       String
  groups             Group[]
  tournament         Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@map("tournament_stages")
}

model Player {
  id           String       @id @default(cuid())
  name         String
  gameUuid     String?
  email        String?
  phoneNumber  String?
  totalMatches Int          @default(0)
  totalKills   Int          @default(0)
  totalPoints  Int          @default(0)
  averageKills Float        @default(0)
  bestPosition Int?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  playerStats  PlayerStat[]

  @@map("players")
}

model PlayerStat {
  id           String     @id @default(cuid())
  playerId     String
  tournamentId String
  teamName     String
  matches      Int        @default(0)
  totalKills   Int        @default(0)
  totalPoints  Int        @default(0)
  averageKills Float      @default(0)
  bestPosition Int?
  player       Player     @relation(fields: [playerId], references: [id], onDelete: Cascade)
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([playerId, tournamentId])
  @@map("player_stats")
}

model SlotAssignment {
  id                 String            @id @default(cuid())
  slotNumber         Int
  groupId            String
  teamRegistrationId String?
  isActive           Boolean           @default(true)
  assignedAt         DateTime          @default(now())
  assignedBy         String
  slotType           String            @default("TEAM_SLOT")
  assignedByUser     User              @relation(fields: [assignedBy], references: [id])
  group              Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  teamRegistration   TeamRegistration? @relation(fields: [teamRegistrationId], references: [id])

  @@unique([groupId, slotNumber])
  @@index([groupId, isActive])
  @@index([teamRegistrationId])
  @@index([groupId, slotNumber])
  @@map("slot_assignments")
}

model ScoringRule {
  id                 String     @id @default(cuid())
  tournamentId       String
  killPoints         Int        @default(1)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  createdBy          String
  customFormula      String?
  description        String?
  isActive           Boolean    @default(true)
  positionMultiplier Float      @default(1.0)
  priority           Int        @default(1)
  ruleName           String
  ruleType           String
  tournament         Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, priority])
  @@map("scoring_rules")
}

model MatchResult {
  id                 String           @id @default(cuid())
  matchId            String
  teamRegistrationId String
  slotNumber         Int
  position           Int
  totalKills         Int
  killPoints         Int
  positionPoints     Int
  totalMatchPoints   Int
  playerResults      Json
  verifiedBy         String?
  verifiedAt         DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  match              Match            @relation(fields: [matchId], references: [id], onDelete: Cascade)
  teamRegistration   TeamRegistration @relation(fields: [teamRegistrationId], references: [id], onDelete: Cascade)
  verifier           User?            @relation(fields: [verifiedBy], references: [id])

  @@unique([matchId, teamRegistrationId])
  @@index([teamRegistrationId, createdAt])
  @@index([matchId, position])
  @@index([teamRegistrationId, totalMatchPoints(sort: Desc)])
  @@index([matchId, totalKills(sort: Desc)])
  @@index([createdAt])
  @@map("match_results")
}

model Subscription {
  id            String       @id @default(cuid())
  price         Float
  features      Json
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  billingCycle  BillingCycle
  planName      String
  stripePriceId String?      @unique
  users         User[]

  @@map("subscriptions")
}

model Tournament {
  id                 String                   @id @default(cuid())
  name               String
  game               String
  status             TournamentStatus         @default(UPCOMING)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  userId             String
  entryFee           Float?
  maxTeams           Int?
  prizePool          Float?
  tournamentType     TournamentType           @default(TOURNAMENT)
  allowCollaborators Boolean                  @default(false)
  currentStage       Int                      @default(1)
  maxTeamsPerGroup   Int                      @default(25)
  registrationFields Json?
  totalStages        Int                      @default(1)
  tournamentFormat   TournamentFormat         @default(ELIMINATION)
  groups             Group[]
  matches            Match[]
  playerStats        PlayerStat[]
  scoringRule        ScoringRule[]
  teamRegistrations  TeamRegistration[]
  collaborators      TournamentCollaborator[]
  stages             TournamentStage[]
  user               User                     @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@index([game, status])
  @@index([name])
  @@map("tournaments")
}

model Team {
  id        String   @id @default(cuid())
  name      String
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  @@map("teams")
}

model Match {
  id            String        @id @default(cuid())
  matchNumber   Int
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  matchDate     DateTime      @default(now())
  processedData Json?
  status        MatchStatus   @default(PENDING_PROCESSING)
  tournamentId  String
  groupId       String?
  resultStatus  ResultStatus  @default(PENDING)
  stageNumber   Int?
  matchResults  MatchResult[]
  group         Group?        @relation(fields: [groupId], references: [id])
  tournament    Tournament    @relation(fields: [tournamentId], references: [id])
  screenshots   Screenshot[]

  @@index([tournamentId, matchNumber])
  @@index([groupId, matchNumber])
  @@index([status, createdAt])
  @@index([tournamentId, status])
  @@index([resultStatus])
  @@map("matches")
}

model Screenshot {
  id           String         @id @default(cuid())
  originalName String
  fileName     String
  fileSize     Int
  mimeType     String
  type         ScreenshotType
  storageUrl   String
  isProcessed  Boolean        @default(false)
  uploadedAt   DateTime       @default(now())
  matchId      String
  match        Match          @relation(fields: [matchId], references: [id])

  @@map("screenshots")
}

model Template {
  id               String              @id @default(cuid())
  templateName     String
  imageUrl         String
  configJson       Json
  isPublic         Boolean             @default(false)
  templateType     TemplateType        @default(PREDEFINED)
  originalImageUrl String?
  isActive         Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  userId           String
  dataFields       TemplateDataField[]
  user             User                @relation(fields: [userId], references: [id])

  @@map("templates")
}

model TemplateDataField {
  id         String        @id @default(cuid())
  fieldType  DataFieldType
  x          Int
  y          Int
  width      Int
  height     Int
  fontSize   Int?
  fontColor  String?
  alignment  TextAlignment @default(LEFT)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  templateId String
  template   Template      @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@map("template_data_fields")
}

model Group {
  id                 String             @id @default(cuid())
  name               String
  maxTeams           Int                @default(24)
  qualificationSpots Int                @default(8)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  tournamentId       String
  matchCount         Int                @default(1)
  maxSlots           Int                @default(25)
  stageId            String?
  stage              TournamentStage?   @relation(fields: [stageId], references: [id])
  tournament         Tournament         @relation(fields: [tournamentId], references: [id])
  matches            Match[]
  slotAssignments    SlotAssignment[]
  teamRegistrations  TeamRegistration[]

  @@index([tournamentId])
  @@index([stageId])
  @@index([tournamentId, createdAt])
  @@map("groups")
}

model TeamRegistration {
  id                 String           @id @default(cuid())
  teamName           String
  contactInfo        String
  registrationStatus String           @default("PENDING")
  finalPosition      Int?
  totalPoints        Int              @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  tournamentId       String
  groupId            String?
  currentStage       Int              @default(1)
  playerDetails      Json?
  slotNumber         Int?
  matchResults       MatchResult[]
  slotAssignments    SlotAssignment[]
  group              Group?           @relation(fields: [groupId], references: [id])
  tournament         Tournament       @relation(fields: [tournamentId], references: [id])

  @@index([tournamentId, totalPoints(sort: Desc)])
  @@index([groupId, totalPoints(sort: Desc)])
  @@index([tournamentId, createdAt])
  @@index([tournamentId, registrationStatus])
  @@index([teamName])
  @@index([totalPoints(sort: Desc), createdAt])
  @@index([currentStage, totalPoints(sort: Desc)])
  @@map("team_registrations")
}

model Payment {
  id            String        @id @default(cuid())
  amount        Float
  currency      String        @default("INR")
  status        PaymentStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  userId        String
  creditsAdded  Int?
  purchaseType  PurchaseType
  transactionId String        @unique
  user          User          @relation(fields: [userId], references: [id])

  @@map("payments")
}

model ActivityLog {
  id        String   @id @default(cuid())
  action    String
  details   Json?
  timestamp DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  @@map("activity_logs")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id                    String   @id @default(cuid())
  userId                String
  createdAt             DateTime @default(now())
  deviceInfo            String?
  ipAddress             String?
  isActive              Boolean  @default(true)
  lastUsedAt            DateTime @default(now())
  refreshTokenExpiresAt DateTime
  refreshTokenHash      String   @unique
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model QuickTournamentSeries {
  id               String            @id @default(cuid())
  seriesName       String
  game             String            @default("BGMI")
  totalMatches     Int               @default(3)
  matchesCompleted Int               @default(0)
  status           QuickSeriesStatus @default(CREATED)

  // Series progression
  currentMatchNumber Int     @default(1)
  isFinished         Boolean @default(false)
  winnerTeamName     String?
  finalStandings     Json? // Array of team standings

  // Metadata
  userId                 String
  slotSourceQuickMatchId String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  // Relations
  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  seriesMatches QuickSeriesMatch[]
  leaderboard   QuickSeriesLeaderboard?
  mediaAssets   QuickMediaAsset[]

  // Indexes
  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@index([userId, status])
  @@map("quick_tournament_series")
}

model QuickSeriesMatch {
  id           String    @id @default(cuid())
  seriesId     String
  quickMatchId String    @unique
  matchOrder   Int // 1st match, 2nd match, etc.
  isCompleted  Boolean   @default(false)
  completedAt  DateTime?

  // Match-specific overrides (optional)
  matchWeight Float @default(1.0) // For weighted scoring
  bonusPoints Int   @default(0) // Bonus points for this match

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  series     QuickTournamentSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  quickMatch QuickMatch            @relation(fields: [quickMatchId], references: [id], onDelete: Cascade)

  // Indexes
  @@unique([seriesId, matchOrder])
  @@index([seriesId, matchOrder])
  @@index([quickMatchId])
  @@map("quick_series_matches")
}

model QuickSeriesLeaderboard {
  id               String   @id @default(cuid())
  seriesId         String   @unique
  leaderboardData  Json // Array of team standings with aggregated scores
  lastUpdatedMatch Int      @default(0)
  generatedAt      DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  series QuickTournamentSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  // Indexes
  @@index([seriesId])
  @@map("quick_series_leaderboards")
}

model QuickMatch {
  id             String           @id @default(cuid())
  matchName      String
  game           String           @default("BGMI")
  map            String?
  status         QuickMatchStatus
  processingStep String?
  aiProcessingId String?
  teamsDetected  Int              @default(0)
  warningsCount  Int              @default(0)

  positionPointsConfig Json?
  killPointsValue      Int     @default(1) // Points per kill
  scoringDescription   String?

  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations (rest stays same)
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  slotAssignments QuickSlotAssignment[]
  screenshots     QuickScreenshot[]
  results         QuickMatchResult[]
  pointsTable     QuickPointsTable?
  seriesMatch     QuickSeriesMatch?
  QuickMatchCrop  QuickMatchCrop[]
  mediaAssets     QuickMediaAsset[]

  // Indexes (rest stays same)
  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@index([userId, status])
  @@map("quick_matches")
}

model QuickSlotAssignment {
  id                   String     @id @default(cuid())
  quickMatchId         String
  slotNumber           Int
  teamName             String
  playerNames          Json? // Array of player names
  status               SlotStatus @default(PENDING)
  detectedInAttendance Boolean    @default(false)
  logoPresetEntryId    String?
  matchLogoR2Key       String?
  matchLogoStorageUrl  String?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  // Relations
  quickMatch      QuickMatch           @relation(fields: [quickMatchId], references: [id], onDelete: Cascade)
  logoPresetEntry TeamLogoPresetEntry? @relation(fields: [logoPresetEntryId], references: [id], onDelete: SetNull)

  // Indexes
  @@unique([quickMatchId, slotNumber])
  @@index([quickMatchId, status])
  @@index([quickMatchId, teamName])
  @@index([logoPresetEntryId])
  @@map("quick_slot_assignments")
}

model QuickScreenshot {
  id           String              @id @default(cuid())
  quickMatchId String
  originalName String
  fileName     String
  storageUrl   String
  type         QuickScreenshotType
  pageNumber   Int?
  isProcessed  Boolean             @default(false)
  uploadedAt   DateTime            @default(now())

  // Relations
  quickMatch QuickMatch @relation(fields: [quickMatchId], references: [id], onDelete: Cascade)

  // Indexes
  @@index([quickMatchId, type])
  @@index([quickMatchId, isProcessed])
  @@map("quick_screenshots")
}

model QuickMatchResult {
  id               String       @id @default(cuid())
  quickMatchId     String
  slotNumber       Int
  teamName         String
  detectedTeamName String?
  position         Int
  rank             Int
  totalKills       Int
  positionPoints   Int
  killPoints       Int
  totalPoints      Int
  playerResults    Json? // Individual player stats
  status           ResultStatus @default(PENDING)
  warningType      String?
  needsReview      Boolean      @default(false)
  aiConfidence     Float?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  // Relations
  quickMatch QuickMatch @relation(fields: [quickMatchId], references: [id], onDelete: Cascade)

  // Indexes
  @@unique([quickMatchId, slotNumber])
  @@index([quickMatchId, totalPoints(sort: Desc)])
  @@index([quickMatchId, needsReview])
  @@index([quickMatchId, position])
  @@map("quick_match_results")
}

model QuickMatchCrop {
  id           String    @id @default(cuid())
  quickMatchId String
  originalUrl  String // Original screenshot URL
  cropUrl      String // Crop image R2 URL  
  r2Key        String // R2 storage key
  cropData     Json // Crop coordinates/metadata from Python API
  cropType     String // Type of crop (e.g., "kill_feed", "leaderboard")
  isActive     Boolean   @default(true)
  expiresAt    DateTime? // For cleanup
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  quickMatch QuickMatch @relation(fields: [quickMatchId], references: [id], onDelete: Cascade)

  // Indexes
  @@index([quickMatchId, cropType])
  @@index([quickMatchId, isActive])
  @@index([expiresAt])
  @@map("quick_match_crops")
}

model QuickPointsTable {
  id               String    @id @default(cuid())
  quickMatchId     String    @unique
  tableImageUrl    String?
  csvData          Json?
  pngGeneratedAt   DateTime?
  generationTimeMs Int?
  template         String    @default("default")
  expiresAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relations
  quickMatch QuickMatch @relation(fields: [quickMatchId], references: [id], onDelete: Cascade)

  // Indexes
  @@index([quickMatchId])
  @@index([expiresAt])
  @@map("quick_points_tables")
}

enum QuickMediaAssetType {
  STANDINGS
  SLOT_LIST
  ROSTER
  TOP_10
  SERIES_STANDINGS
}

model QuickMediaAsset {
  id            String              @id @default(cuid())
  userId        String
  quickMatchId  String?
  quickSeriesId String?
  assetType     QuickMediaAssetType
  r2Key         String
  mimeType      String              @default("image/png")
  filename      String?
  metadata      Json?
  createdAt     DateTime            @default(now())

  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  quickMatch  QuickMatch?            @relation(fields: [quickMatchId], references: [id], onDelete: Cascade)
  quickSeries QuickTournamentSeries? @relation(fields: [quickSeriesId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([quickMatchId, createdAt(sort: Desc)])
  @@index([quickSeriesId, createdAt(sort: Desc)])
  @@map("quick_media_assets")
}

enum QuickSeriesStatus {
  CREATED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  PAST_DUE
  CANCELED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum TournamentStatus {
  UPCOMING
  ONGOING
  COMPLETED
}

enum MatchStatus {
  PENDING_PROCESSING
  PROCESSED
  ERROR
}

enum PaymentStatus {
  SUCCEEDED
  PENDING
  FAILED
}

enum PurchaseType {
  SUBSCRIPTION
  CREDIT_PACK
}

enum ScreenshotType {
  SLOT_LIST
  RESULT_SCREEN
}

enum TemplateType {
  PREDEFINED
  CUSTOM
}

enum DataFieldType {
  TEAM_NAME
  PLAYER_NAME
  KILLS
  POSITION
  POINTS
  MATCH_TITLE
  DATE
  TOURNAMENT_NAME
}

enum TournamentFormat {
  ELIMINATION
  ROUND_ROBIN
  MIXED
}

enum StageFormat {
  ELIMINATION
  ROUND_ROBIN
}

enum ResultStatus {
  PENDING
  PROCESSED
  VERIFIED
  MANUAL_ENTRY
}

enum UserRole {
  OWNER
  ADMIN
  MODERATOR
  RESULT_VERIFIER
  VIEWER
}

enum CollaboratorStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum TextAlignment {
  LEFT
  CENTER
  RIGHT
}

enum TournamentType {
  TOURNAMENT
}

enum QuickMatchStatus {
  ACTIVE
  COMPLETED
  ERROR
}

enum QuickScreenshotType {
  ATTENDANCE
  RESULT
}

enum SlotStatus {
  PENDING
  DETECTED
  MATCHED
  NOT_FOUND
}

enum TieBreakingRuleType {
  KILL_POINTS
  PLACEMENT_POINTS
  TOTAL_POINTS
  CUSTOM_FIELD
  MANUAL
}

enum TieBreakingEntityType {
  MATCH
  SERIES
}

enum ConflictStatus {
  DETECTED
  RESOLVED_AUTO
  RESOLVED_MANUAL
  IGNORED
}

// ========================================
// TIE-BREAKING MODELS
// ========================================

model TieBreakingConfig {
  id                 String                @id @default(cuid())
  entityId           String // QuickMatch.id or QuickTournamentSeries.id
  entityType         TieBreakingEntityType
  autoResolveEnabled Boolean               @default(true)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  createdBy          String

  user      User              @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  rules     TieBreakingRule[]
  conflicts ConflictGroup[]

  @@unique([entityId, entityType])
  @@map("tie_breaking_configs")
}

model TieBreakingRule {
  id          String              @id @default(cuid())
  configId    String
  type        TieBreakingRuleType
  priority    Int // 1-10, lower number = higher priority
  ascending   Boolean             @default(false) // false = descending (higher values win)
  fieldName   String? // For CUSTOM_FIELD type
  description String?
  createdAt   DateTime            @default(now())

  config TieBreakingConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@unique([configId, priority])
  @@map("tie_breaking_rules")
}

model ConflictGroup {
  id          String         @id @default(cuid())
  configId    String
  status      ConflictStatus @default(DETECTED)
  conflictKey String // Hash of conflicting values (e.g., "15-5" for 15 total, 5 kills)
  detectedAt  DateTime       @default(now())
  resolvedAt  DateTime?
  resolvedBy  String? // User ID who resolved manually
  reason      String? // Reason for manual resolution

  config            TieBreakingConfig   @relation(fields: [configId], references: [id], onDelete: Cascade)
  resolver          User?               @relation(fields: [resolvedBy], references: [id], onDelete: SetNull)
  manualResolutions ManualTieBreaking[]

  @@map("conflict_groups")
}

model ManualTieBreaking {
  id              String   @id @default(cuid())
  conflictGroupId String
  resultId        String // QuickResult.id or aggregated series result identifier
  finalPosition   Int // User-defined position (1, 2, 3, etc.)
  createdAt       DateTime @default(now())

  conflictGroup ConflictGroup @relation(fields: [conflictGroupId], references: [id], onDelete: Cascade)

  @@unique([conflictGroupId, resultId])
  @@unique([conflictGroupId, finalPosition])
  @@map("manual_tie_breaking")
}

// ========================================
// TEAM LOGO PRESETS
// ========================================

model TeamLogoPreset {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries TeamLogoPresetEntry[]

  @@index([userId, createdAt(sort: Desc)])
  @@map("team_logo_presets")
}

model TeamLogoPresetEntry {
  id             String   @id @default(cuid())
  presetId       String
  teamName       String
  logoR2Key      String
  logoStorageUrl String
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  preset          TeamLogoPreset        @relation(fields: [presetId], references: [id], onDelete: Cascade)
  slotAssignments QuickSlotAssignment[]

  @@index([presetId, sortOrder])
  @@map("team_logo_preset_entries")
}
